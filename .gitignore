# DELIBERATELY EXCLUDED FROM THE PUBLIC REPOSITORY
# -----------------------------------------------------------------------------
# These files stay on disk but are never committed. Each rule states why.
# Remove a rule only after its underlying concern has been resolved.
# =============================================================================

# Visual Studio project files. The .pyproj declares the organiser-supplied
# confidential portfolio filename as build content, and neither file is needed
# to run the pipeline or to review the project on GitHub.
*.slnx
*.pyproj

# Third-party annex; redistribution rights have not been established.
IoT_Seismic_Monitoring_Annex.pdf

# Stale pre-refactor duplicates sitting in the script folder. The canonical
# regenerated copies live in outputs/ and ARE committed. Path-anchored so the
# outputs/ versions are unaffected.
/RisquePredictionCatBoost/RisquePredictionCatBoost/Algeria_Seismic_Risk_By_Year.xlsx
/RisquePredictionCatBoost/RisquePredictionCatBoost/Algeria_Seismic_Summary_for_QGIS.xlsx

# Superseded zone-join tables from earlier iterations. They contradict the
# authoritative zones_rpa99_final.csv (961 and 410 of 1,541 rows differ) and
# would mislead anyone trying to reproduce the seismic-zone mapping.
/qgis_join_table_corrected.csv
/qgis_join_table_final.csv
